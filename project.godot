; WORLDBACK — Godot 4.6.x, standard build / GDScript.
config_version=5

[application]
config/name="WORLDBACK"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/description="A handcrafted dark fantasy action RPG. Follow the old migration road."

[autoload]
Game="*res://scripts/core/game.gd"
Sound="*res://scripts/core/audio.gd"

[display]
window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[input]
move_left={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":65),Object(InputEventJoypadMotion,"axis":0,"axis_value":-1.0)]}
move_right={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":68),Object(InputEventJoypadMotion,"axis":0,"axis_value":1.0)]}
jump={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":32),Object(InputEventJoypadButton,"button_index":0)]}
dodge={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194325),Object(InputEventJoypadButton,"button_index":1)]}
attack={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":74),Object(InputEventJoypadButton,"button_index":2)]}
block={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":75),Object(InputEventJoypadButton,"button_index":9)]}
interact={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":69),Object(InputEventJoypadButton,"button_index":3)]}
heal={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":81),Object(InputEventJoypadButton,"button_index":10)]}
inventory={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194306)]}
map={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":77)]}
pause={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194305),Object(InputEventJoypadButton,"button_index":6)]}

[physics]
common/physics_ticks_per_second=60

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.025,0.045,0.058,1)
